# ---------------------------------------------------------------------------
# ÓRBITA — variáveis de ambiente
# Copie para .env.local e preencha. Nunca comite .env.local.
# ---------------------------------------------------------------------------

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Somente servidor. Necessária para rotas administrativas (convites, cotas,
# limpeza de uploads). NUNCA exponha no cliente.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do app, usada em links de confirmação e convites.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Limpeza diária de arquivos (POST /api/cron/purge-files com Authorization: Bearer <valor>).
# Gere com: openssl rand -hex 32
CRON_SECRET=
